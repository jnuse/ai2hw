<view class="history-container"><view class="navbar"><view data-event-opts="{{[['tap',[['navigateBack',['$event']]]]]}}" class="navbar-left" bindtap="__e"><text class="back-icon">←</text></view><text class="navbar-title">历史记录</text><view class="navbar-right"></view></view><scroll-view class="history-list" scroll-y="true" data-event-opts="{{[['scrolltolower',[['loadMoreHistory',['$event']]]]]}}" bindscrolltolower="__e"><block wx:for="{{historyList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['viewHistoryDetail',['$0'],[[['historyList','',index,'id']]]]]]]}}" class="history-item" bindtap="__e"><view class="history-content"><text class="history-title">{{item.title}}</text><text class="history-time">{{item.created_at}}</text></view><view class="history-actions"><text data-event-opts="{{[['tap',[['confirmDelete',['$0'],[[['historyList','',index,'id']]]]]]]}}" class="history-delete" catchtap="__e">×</text><text class="history-arrow">›</text></view></view></block><block wx:if="{{isLoading}}"><view class="loading-more"><text>加载中...</text></view></block><block wx:if="{{$root.g0}}"><view class="empty-tip"><text>暂无历史记录</text></view></block></scroll-view><view class="bottom-nav"><view data-event-opts="{{[['tap',[['navigateToChat',['$event']]]]]}}" class="nav-btn" bindtap="__e"><text class="nav-text">智能问答</text></view><view data-event-opts="{{[['tap',[['navigateToHistory',['$event']]]]]}}" class="nav-btn active" bindtap="__e"><text class="nav-text">历史记录</text></view></view></view>