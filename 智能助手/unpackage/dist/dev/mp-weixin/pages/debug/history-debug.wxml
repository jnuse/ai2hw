<view class="debug-container"><view class="navbar"><view data-event-opts="{{[['tap',[['navigateBack',['$event']]]]]}}" class="navbar-left" bindtap="__e"><text class="back-icon">←</text></view><text class="navbar-title">历史记录调试</text><view class="navbar-right"></view></view><view class="content"><view class="input-box"><input type="text" placeholder="输入记录ID" data-event-opts="{{[['input',[['__set_model',['','recordId','$event',[]]]]]]}}" value="{{recordId}}" bindinput="__e"/><button data-event-opts="{{[['tap',[['loadRecord',['$event']]]]]}}" bindtap="__e">加载</button></view><block wx:if="{{record}}"><view class="record-info"><view class="info-item"><text class="label">ID:</text><text class="value">{{record.id}}</text></view><view class="info-item"><text class="label">标题:</text><text class="value">{{record.title}}</text></view><view class="info-item"><text class="label">摘要:</text><text class="value">{{record.summary}}</text></view><view class="info-item"><text class="label">时间:</text><text class="value">{{record.created_at}}</text></view><view class="info-item content-item"><text class="label">内容:</text><textarea class="content-value" disabled="{{true}}" data-event-opts="{{[['input',[['__set_model',['$0','content','$event',[]],['record']]]]]}}" value="{{record.content}}" bindinput="__e"></textarea></view><button data-event-opts="{{[['tap',[['parseAndShow',['$event']]]]]}}" bindtap="__e">解析内容</button></view></block><block wx:if="{{$root.g0>0}}"><view class="parsed-messages"><text class="section-title">解析后的消息:</text><block wx:for="{{messages}}" wx:for-item="msg" wx:for-index="index" wx:key="index"><view class="{{['message-item',msg.sender==='user'?'user-msg':'assistant-msg']}}"><text class="sender">{{msg.sender}}</text><text class="content">{{msg.content}}</text></view></block></view></block></view></view>